{
  "_comment": [
    "面板执行门 —— 直接复用 App 自己的会话权限三档，不另造一套。",
    "App 侧枚举：com.openminis.app.security.SessionPermissionMode",
    "  ASK_BEFORE_CHANGES -> PermissionMode.ASK      (变更前确认)",
    "  AUTONOMOUS         -> PermissionMode.GUARDED  (自主模式)",
    "  FULL_ACCESS        -> PermissionMode.ALLOW_ALL(完全访问 / yolo)",
    "FULL_ACCESS 下不弹二次确认：选了 yolo 就是要它跑，再问一遍等于没选。",
    "另有一类操作 App 自己有权限入口，不走命令分类器、也不在面板执行 —— 见 delegated。"
  ],
  "version": 2,
  "defaultMode": "ASK_BEFORE_CHANGES",
  "modes": {
    "ASK_BEFORE_CHANGES": {
      "label": "变更前确认",
      "appMode": "ASK",
      "confirmRisk": [
        "medium",
        "high"
      ],
      "confirmWrites": true,
      "requireReason": true,
      "_note": "只读工具即使 low 也不确认；它没有变更"
    },
    "AUTONOMOUS": {
      "label": "自主模式",
      "appMode": "GUARDED",
      "confirmRisk": [
        "high"
      ],
      "confirmWrites": false,
      "requireReason": true,
      "_note": "自主模式=GUARDED：中风险写入直接放行，只有高危（破坏性）才拦。若这里也 confirm medium，它会与「变更前确认」等价，三档就退化成两档。"
    },
    "FULL_ACCESS": {
      "label": "完全访问",
      "appMode": "ALLOW_ALL",
      "confirmRisk": [],
      "confirmWrites": false,
      "requireReason": false
    }
  },
  "delegated": [
    {
      "id": "settings",
      "route": "设置 → 对应分区",
      "why": "改配置是设置页的职责，它有独立权限入口，不经命令分类器",
      "prefixes": [
        "setting",
        "props_",
        "prop_",
        "cmd_settings_",
        "wm_"
      ],
      "exact": [
        "appops_set"
      ]
    },
    {
      "id": "session",
      "route": "会话菜单 → 删除",
      "why": "删会话走会话菜单，面板不该提供这条命令路径",
      "prefixes": [
        "session_delete",
        "session_remove",
        "session_purge",
        "chat_delete",
        "chat_remove"
      ],
      "exact": []
    }
  ],
  "riskUpgrade": {
    "_comment": "名字命中这些词的工具，无论注册表怎么标，一律按 high 处理",
    "keywords": [
      "rm_",
      "delete",
      "kill",
      "force_stop",
      "wipe",
      "format",
      "uninstall",
      "disable",
      "flash",
      "dd_",
      "chmod",
      "mount_",
      "reboot",
      "shutdown"
    ]
  }
}